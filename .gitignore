# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit any env variant
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.backup
.env.bak
.env.prod
.env.old
.env.copy
.env.example.local
*.env
*.env.local
*.env.backup

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP config — contains service role key, never commit
.mcp.json
e2e-edunexus.mjs

# generated test/debug artifacts — not source
generated-reports/*.pdf
!generated-reports/.gitkeep
/*-test.pdf

# growth outreach data — real school contact PII / campaign logs, not source
scripts/growth/output/
.aider*

# book build pipeline — isolated node project + generated PDF, not source
scripts/book-build/node_modules/
docs/manuscript/engineering-educational-intelligence/dist/

{
  "$id": "jashor-breaker/edunexus-adapter-config",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodePolicy", "secretScan", "acceptedRisks"],
  "properties": {
    "nodePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "minimumPatch", "source"],
      "properties": {
        "line": { "type": "integer" },
        "minimumPatch": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "source": { "type": "string", "description": "Official advisory URL the floor comes from (documentation only; never fetched)." }
      }
    },
    "acceptedRisks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registerPath", "warnWithinDays", "requireOwner", "requireReviewDate"],
      "properties": {
        "registerPath": { "type": "string", "minLength": 1 },
        "warnWithinDays": { "type": "integer", "minimum": 0, "maximum": 365 },
        "requireOwner": { "type": "boolean" },
        "requireReviewDate": { "type": "boolean" }
      }
    },
    "secretScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignorePrefixes", "maxFileBytes"],
      "properties": {
        "ignorePrefixes": { "type": "array", "items": { "type": "string" } },
        "maxFileBytes": { "type": "integer" }
      }
    }
  }
}

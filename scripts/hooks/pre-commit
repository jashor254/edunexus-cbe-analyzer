#!/usr/bin/env bash
# ─── EduNexus Secret Scanner — pre-commit hook ───────────────────────────────
# Blocks commits containing API keys, tokens, passwords, or files that must
# never be public (the repo is public). Versioned here and activated by
# `npm install` (scripts/install-git-hooks.mjs sets core.hooksPath), so a fresh
# clone is protected without a manual copy into .git/hooks.
#
# Only ADDED lines are scanned, and hits are reported as file:line — the
# matched text is never echoed, so the secret doesn't end up in terminal
# scrollback or CI logs.
#
# To bypass (EMERGENCY ONLY): git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "Scanning staged files for secrets..."

BLOCKED=0
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

# ─── 1. Block sensitive filenames ─────────────────────────────────────────────
BLOCKED_FILE_PATTERNS=(
  "(^|/)\.env$"
  "(^|/)\.env\."
  "\.mcp\.json$"
  "^e2e-.*\.(mjs|ts|js)$"
  "\.pem$"
  "\.key$"
  "\.p12$"
  "\.pfx$"
  "credentials\.json$"
  "secrets\.json$"
  "service-account.*\.json$"
  "^[^/]+\.pdf$"          # root-level PDFs are generated (often real learner) reports
  "^test-[^/]*\.html$"    # root-level key/probe pages
)

while IFS= read -r file; do
  [ -z "$file" ] && continue
  for pattern in "${BLOCKED_FILE_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      echo -e "${RED}BLOCKED${NC} — sensitive filename staged: $file"
      echo -e "         Remove with: git restore --staged \"$file\""
      BLOCKED=1
      break
    fi
  done
done <<< "$STAGED_FILES"

# ─── 2. Scan added lines for secret patterns ──────────────────────────────────
declare -A PATTERNS
PATTERNS["Supabase PAT"]="sbp_[a-zA-Z0-9]{36,}"
PATTERNS["Supabase JWT key"]="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[a-zA-Z0-9_-]{40,}"
PATTERNS["Supabase secret key"]="sb_secret_[A-Za-z0-9_-]{20,}"
PATTERNS["Paystack live key"]="sk_live_[a-zA-Z0-9]{20,}"
PATTERNS["Paystack test key"]="sk_test_[a-zA-Z0-9]{20,}"
PATTERNS["DeepSeek / OpenAI key"]="sk-[a-zA-Z0-9]{30,}"
PATTERNS["Google API key"]="AIza[0-9A-Za-z_-]{35}"
PATTERNS["Meta / WhatsApp token"]="EAA[A-Za-z0-9]{100,}"
PATTERNS["AWS Access Key"]="AKIA[0-9A-Z]{16}"
PATTERNS["Private key block"]="-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY"
PATTERNS["Generic SERVICE_KEY"]="SERVICE[_-]?KEY[[:space:]]*=[[:space:]]*['\"][a-zA-Z0-9_-]{20,}['\"]"
PATTERNS["Generic SECRET_KEY"]="SECRET[_-]?KEY[[:space:]]*=[[:space:]]*['\"][a-zA-Z0-9_-]{20,}['\"]"
PATTERNS["Generic API_KEY"]="API[_-]?KEY[[:space:]]*=[[:space:]]*['\"][a-zA-Z0-9_-]{20,}['\"]"
PATTERNS["Generic PASSWORD"]="PASSWORD[[:space:]]*=[[:space:]]*['\"][^'\"]{8,}['\"]"

# Every added line as "file:line<TAB>content", tracking hunk headers so a hit
# can be reported by location instead of by content.
ADDED_LINES=$(git diff --cached -U0 --diff-filter=ACMR --no-color 2>/dev/null | awk '
  /^\+\+\+ b\// { file = substr($0, 7); next }
  /^@@/ { split($3, a, ","); line = substr(a[1], 2) + 0; next }
  /^\+/ { print file ":" line "\t" substr($0, 2); line++ }
' || true)

for label in "${!PATTERNS[@]}"; do
  pattern="${PATTERNS[$label]}"
  locations=$(printf '%s\n' "$ADDED_LINES" | grep -E -- "$pattern" 2>/dev/null | cut -f1 || true)
  if [ -n "$locations" ]; then
    echo -e "${RED}BLOCKED${NC} — ${YELLOW}${label}${NC} detected at:"
    printf '%s\n' "$locations" | head -5 | sed 's/^/         /'
    BLOCKED=1
  fi
done

# ─── Result ───────────────────────────────────────────────────────────────────
if [ "$BLOCKED" -eq 1 ]; then
  echo ""
  echo -e "${RED}COMMIT BLOCKED — remove the secret before committing${NC}"
  echo ""
  echo "  Fix:"
  echo "  1. Move secrets to .env.local (already gitignored)"
  echo "  2. Unstage the file: git restore --staged <file>"
  echo "  3. If already pushed: ROTATE the key first — the repo is public, so"
  echo "     removing it from history alone does not make it safe"
  echo ""
  exit 1
fi

echo -e "${GREEN}No secrets detected — commit allowed${NC}"
exit 0
